# Secrets - never commit
.env
.env.*
*.pem
*.key
credentials.json
token.json

# Yahoo notebooks carry hardcoded OAuth tokens in source cells.
# Sanitized copies live in notebooks/ instead. Do not un-ignore these.
made-resources/py/*.ipynb

# Local Python
.venv/
venv/
__pycache__/
*.pyc

# OS
.DS_Store

# Immutable raw pulls are kept locally, not versioned, except small snapshots
raw/**/*.json
raw/**/*.zip
!raw/**/manifest*.json

# Scratch
out/**/*.tmp

# Member PII and finances are NOT in this repo. The archive was pruned to the
# files the pipeline reads (docs/LEAGUELEGACY_COVERAGE_AUDIT.md addendum); the
# member, finance, achievement and franchise-dashboard files are deleted, not
# ignored. This rule previously named only the made-resources copy and was
# defeated by the duplicate LeagueLegacy-io root - which is why the exposure
# happened. There is now ONE archive root. Do not re-add the full export.
LeagueLegacy-io/**/16_franchise/
LeagueLegacy-io/**/08_finances/
LeagueLegacy-io/**/14_members/
LeagueLegacy-io/**/members.csv
LeagueLegacy-io/**/finances*
LeagueLegacy-io/**/achievements*

# secret literal list for the transcript redactor - never commit
.redact-literals

# third-party clone, has its own git repo
sleeper-mcp-server/
